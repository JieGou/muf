<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WpfUndoControls"
    xmlns:internal="clr-namespace:WpfUndoControls.Internal"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors">

    <!--  Common ListBoxItem Style  -->
    <Style x:Key="TransparentListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Common Border Style for Undo/Redo Items  -->
    <Style x:Key="UndoListItemBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="2" />
        <Setter Property="BorderBrush" Value="#0078D7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter Property="Background" Value="#CDE6F7" />
                <Setter Property="BorderThickness" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Separator Template  -->
    <DataTemplate DataType="{x:Type internal:UndoListSeparator}">
        <Separator HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
    </DataTemplate>

    <!--  UndoListItem Template  -->
    <DataTemplate DataType="{x:Type internal:UndoListItem}">
        <Border Style="{StaticResource UndoListItemBorderStyle}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseEnter">
                    <i:InvokeCommandAction Command="{Binding PreviewCommand}" CommandParameter="{Binding}" />
                </i:EventTrigger>
                <i:EventTrigger EventName="MouseLeftButtonUp">
                    <i:InvokeCommandAction Command="{Binding ClickCommand}" CommandParameter="{Binding UndoItem}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <TextBlock Padding="4" Text="{Binding Description}" />
        </Border>
    </DataTemplate>

    <!--  UndoListOption Template  -->
    <DataTemplate DataType="{x:Type internal:UndoListOption}">
        <Border Margin="2" Padding="4" Background="Transparent">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseEnter">
                    <i:InvokeCommandAction Command="{Binding PreviewCommand}" CommandParameter="{Binding}" />
                </i:EventTrigger>
                <i:EventTrigger EventName="MouseLeftButtonUp">
                    <i:InvokeCommandAction Command="{Binding Command}" CommandParameter="{Binding CommandParameter}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFE5F3FB" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsCancel}" Value="True">
                            <Setter Property="BorderThickness" Value="0,1,0,0" />
                            <Setter Property="BorderBrush" Value="#E0E0E0" />
                            <Setter Property="Margin" Value="0,2,0,0" />
                            <Setter Property="Padding" Value="4,6,4,4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock HorizontalAlignment="Center" Text="{Binding Label}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="Bold" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCancel}" Value="True">
                                <Setter Property="FontWeight" Value="Normal" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </DataTemplate>

    <!-- Base Style for UndoRedoButtonBase -->
    <Style TargetType="{x:Type local:UndoRedoButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource TransparentListBoxItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:UndoRedoButtonBase}">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            SnapsToDevicePixels="true">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <ContentPresenter x:Name="contentPresenter" 
                                              Grid.Column="0" 
                                              Focusable="False" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              Margin="{TemplateBinding Padding}" 
                                              RecognizesAccessKey="True" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            
                            <Border x:Name="PART_SplitElement" 
                                    Grid.Column="1" 
                                    Width="16" 
                                    Background="Transparent" 
                                    SnapsToDevicePixels="True"  
                                    Margin="0,0,1,0">
                                <Path x:Name="arrow" 
                                      Data="M0,0 L3.5,4 L7,0" 
                                      Stroke="Black" 
                                      StrokeThickness="1" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" 
                                      SnapsToDevicePixels="False"/>
                            </Border>
                            
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   Placement="Bottom" 
                                   PlacementTarget="{Binding ElementName=border}" 
                                   PopupAnimation="None" 
                                   StaysOpen="False">
                                <Border Background="#FFFFFFFF" 
                                        BorderBrush="#FFABADB3" 
                                        BorderThickness="1" 
                                        MaxHeight="300" 
                                        MinWidth="{Binding ActualWidth, ElementName=border}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ListBox x:Name="PART_ListBox" 
                                                 ItemsSource="{TemplateBinding ItemsSource}" 
                                                 ItemContainerStyle="{TemplateBinding ItemContainerStyle}" 
                                                 BorderThickness="0" 
                                                 Background="Transparent">
                                            <ListBox.Template>
                                                <ControlTemplate TargetType="ListBox">
                                                    <ItemsPresenter />
                                                </ControlTemplate>
                                            </ListBox.Template>
                                        </ListBox>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="border" Value="#FFEEF5FD"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="#FF0078D7"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" SourceName="PART_SplitElement" Value="True">
                            <Setter Property="Background" TargetName="PART_SplitElement" Value="#FFD8EAF9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- UndoButton Style -->
    <Style TargetType="{x:Type local:UndoButton}" BasedOn="{StaticResource {x:Type local:UndoRedoButtonBase}}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Content">
            <Setter.Value>
                <Image HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Height="16"
                       Width="16"
                       Stretch="Uniform"
                       Source="pack://application:,,,/WpfUndoControls;component/Resources/edit_undohs.png" />
            </Setter.Value>
        </Setter>
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip>
                    <StackPanel>
                        <TextBlock FontWeight="Bold">
                            <Run Text="放弃" />
                            <Run Text="(Ctrl+Z)" />
                        </TextBlock>
                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#666666">
                            用于取消最近执行的操作
                        </TextBlock>
                    </StackPanel>
                </ToolTip>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Content">
                    <Setter.Value>
                        <Image HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Height="16"
                               Width="16"
                               Stretch="Uniform"
                               Source="pack://application:,,,/WpfUndoControls;component/Resources/edit_undohs_grey.png" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- RedoButton Style -->
    <Style TargetType="{x:Type local:RedoButton}" BasedOn="{StaticResource {x:Type local:UndoRedoButtonBase}}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Content">
            <Setter.Value>
                <Image HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Height="16"
                       Width="16"
                       Stretch="Uniform"
                       Source="pack://application:,,,/WpfUndoControls;component/Resources/edit_redohs.png" />
            </Setter.Value>
        </Setter>
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip>
                    <StackPanel>
                        <TextBlock FontWeight="Bold">
                            <Run Text="重做" />
                            <Run Text="(Ctrl+Y)" />
                        </TextBlock>
                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#666666">
                            用于恢复最近执行的操作
                        </TextBlock>
                    </StackPanel>
                </ToolTip>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Content">
                    <Setter.Value>
                        <Image HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Height="16"
                               Width="16"
                               Stretch="Uniform"
                               Source="pack://application:,,,/WpfUndoControls;component/Resources/edit_redohs_grey.png" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
