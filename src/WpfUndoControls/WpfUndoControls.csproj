<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFrameworks>net462;netcoreapp3.1;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RootNamespace>WpfUndoControls</RootNamespace>
    <AssemblyName>WpfUndoControls</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Metadata">
    <Authors>Nathan Allen-Wagner, CGrisselin</Authors>
    <Description>WPF Undo/Redo Button Controls Library - Reusable UI components for undo/redo functionality</Description>
    <Title>WPF Undo Controls</Title>
    <PackageId>WpfUndoControls</PackageId>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Internal\RelayCommand.cs" />
  </ItemGroup>

  <ItemGroup Label="Package References">
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.19" />
    <PackageReference Include="MvvmLightLibsStd10" Version="5.4.1.1" />
  </ItemGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\MonitoredUndo\MonitoredUndo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\edit_redohs.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\edit_undohs.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\edit_undohs_grey.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\edit_redohs_grey.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
