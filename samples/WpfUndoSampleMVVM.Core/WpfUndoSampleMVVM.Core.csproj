<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>

    <IsPackable>false</IsPackable>

    <RootNamespace>WpfUndoSampleMVVM.Core</RootNamespace>
    <AssemblyName>$(RootNamespace)</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Metadata">
    <Authors>Nathan Allen-Wagner, CGrisselin</Authors>
    <Description>Monitored Undo Framework - .NET Core MVVM Sample</Description>
    <Title>Monitored Undo Framework - .NET Core MVVM Sample</Title>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Resources\**" />
    <Compile Remove="Themes\**" />
    <EmbeddedResource Remove="Resources\**" />
    <EmbeddedResource Remove="Themes\**" />
    <None Remove="Resources\**" />
    <None Remove="Themes\**" />
    <Page Remove="Resources\**" />
    <Page Remove="Themes\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="RedoButton.cs" />
    <Compile Remove="UndoButton.cs" />
    <Compile Remove="UndoRedoButtonBase.cs" />
  </ItemGroup>

  <ItemGroup Label="Package References">
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.19" />
    <PackageReference Include="MvvmLightLibsStd10" Version="5.4.1.1" />
  </ItemGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\..\src\MonitoredUndo\MonitoredUndo.csproj" />
    <ProjectReference Include="..\..\src\WpfUndoControls\WpfUndoControls.csproj" />
  </ItemGroup>

</Project>
